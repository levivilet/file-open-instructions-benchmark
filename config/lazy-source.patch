@@ -0,0 +1,26 @@
+import { expect, test } from '@jest/globals'
+import { WidgetId } from '@lvce-editor/constants'
+import { commandMap } from '../src/parts/CommandMap/CommandMap.ts'
+import * as EditorStates from '../src/parts/EditorStates/EditorStates.ts'
+import * as WidgetRegistry from '../src/parts/WidgetRegistry/WidgetRegistry.ts'
+
+test('cold command loading preserves live editor state, aliases, document isolation and widget registration', async () => {
+  expect(WidgetRegistry.get(WidgetId.Find)).toBeUndefined()
+  expect(commandMap['EditorText.offsetAt']).toBe(commandMap['Editor.offsetAt'])
+  const state = { id: 123, lines: ['live editor'], lifecycle: { disposed: false } }
+  EditorStates.set(123, state as any, state as any)
+  const first = { lines: ['a\u0301👩‍💻', 'second'] }
+  const second = { lines: ['x', 'other'] }
+  const offsets = await Promise.all([
+    commandMap['Editor.offsetAt'](first, 1, 2),
+    commandMap['EditorText.offsetAt'](second, 1, 1),
+  ])
+  expect(offsets).toEqual([10, 3])
+  expect(EditorStates.get(123)?.newState).toBe(state)
+  const widget = WidgetRegistry.get(WidgetId.Find)
+  expect(widget).toBeDefined()
+  await expect(commandMap['Editor.offsetAt'](first, 0, 1)).resolves.toBe(1)
+  expect(WidgetRegistry.get(WidgetId.Find)).toBe(widget)
+  await expect(commandMap['Editor.offsetAt'](null, 0, 0)).rejects.toThrow()
+  EditorStates.dispose(123)
+})
