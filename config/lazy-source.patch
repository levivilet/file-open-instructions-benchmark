@@ -0,0 +1,37 @@
+import { expect, test } from '@jest/globals'
+import { WidgetId } from '@lvce-editor/constants'
+import { commandMap } from '../src/parts/CommandMap/CommandMap.ts'
+import * as EditorStates from '../src/parts/EditorStates/EditorStates.ts'
+import { registerWidgets } from '../src/parts/RegisterWidgets/RegisterWidgets.ts'
+import * as WidgetRegistry from '../src/parts/WidgetRegistry/WidgetRegistry.ts'
+
+test('loading cold implementations preserves live state, aliases, document isolation and registered widgets', async () => {
+  const commands = commandMap as Readonly<Record<string, (...args: any[]) => any>>
+  registerWidgets()
+  const widget = WidgetRegistry.get(WidgetId.Find)
+  expect(widget).toBeDefined()
+  expect(commands['EditorText.saveState']).toBe(commands['Editor.saveState'])
+  const first = {
+    id: 123,
+    lines: ['a\u0301👩‍💻', 'second'],
+    selections: [0, 1, 0, 2],
+    widgets: [],
+    undoStack: [],
+    redoStack: [],
+    endOfLine: 'crlf',
+    modified: true,
+  }
+  const second = { ...first, id: 124, lines: ['other editor'], endOfLine: 'lf' }
+  EditorStates.set(123, first as any, first as any)
+  EditorStates.set(124, second as any, second as any)
+  const saved = await Promise.all([commands['Editor.saveState'](123, true), commands['EditorText.saveState'](124, true)])
+  expect(saved.map((state: any) => [state.lines, state.endOfLine])).toEqual([
+    [first.lines, 'crlf'],
+    [second.lines, 'lf'],
+  ])
+  expect(EditorStates.get(123)?.newState).toBe(first)
+  expect(EditorStates.get(124)?.newState).toBe(second)
+  expect(WidgetRegistry.get(WidgetId.Find)).toBe(widget)
+  EditorStates.dispose(123)
+  EditorStates.dispose(124)
+})
diff --git a/packages/editor-worker/test/LazyCommandOrdering.test.ts b/packages/editor-worker/test/LazyCommandOrdering.test.ts
new file mode 100644
index 000000000000..40b6a3d49316
--- /dev/null
+++ b/packages/editor-worker/test/LazyCommandOrdering.test.ts
@@ -0,0 +1,60 @@
+import { expect, jest, test } from '@jest/globals'
+import * as Editors from '../src/parts/EditorStates/EditorStates.ts'
+import * as Queue from '../src/parts/EditorCommandQueue/EditorCommandQueue.ts'
+
+const events: string[] = []
+const gate = Promise.withResolvers<void>()
+const type = (uid: number) =>
+  Queue.enqueue(uid, async () => {
+    events.push('type')
+  })
+const selection = (uid: number) =>
+  Queue.enqueue(uid, async () => {
+    events.push('selection')
+  })
+const wrapCommand =
+  (fn: (...args: any[]) => any) =>
+  (uid: number, ...args: any[]) =>
+    Queue.enqueue(uid, async () => fn(Editors.get(uid)?.newState, ...args))
+jest.unstable_mockModule('../src/parts/WrapRpcCommands/WrapRpcCommands.ts', () => ({
+  wrapCommand,
+  wrapDeferredCommand: wrapCommand,
+  wrapFocusCommand: wrapCommand,
+  wrapLatestCommand: wrapCommand,
+}))
+jest.unstable_mockModule('../src/parts/ShouldOpenAutomaticCompletion/ShouldOpenAutomaticCompletion.ts', () => ({
+  shouldOpenAutomaticCompletion: () => false,
+}))
+jest.unstable_mockModule('../src/parts/ColdHandlers/ColdHandlers.ts', async () => {
+  await gate.promise
+  return {
+    handlers: {
+      'EditorType.type': async (state: any) => {
+        events.push('type')
+        return state
+      },
+    },
+  }
+})
+jest.unstable_mockModule('../src/parts/ExternalGetPositionAtCursor/ExternalGetPositionAtCursor.ts', () => ({ setSelections2: selection }))
+const { commandMap } = await import('../src/parts/CommandMap/CommandMap.ts')
+
+test('baseline queue preserves arrival order', async () => {
+  const state = { id: 721, uri: 'test://baseline' }
+  Editors.set(721, state as any, state as any)
+  await Promise.all([type(721), selection(721)])
+  expect(events.splice(0)).toEqual(['type', 'selection'])
+  Editors.dispose(721)
+})
+
+test('a cold foreground command reserves its place before an eager selection command', async () => {
+  const state = { id: 722, uri: 'test://candidate', widgets: [] }
+  Editors.set(722, state as any, state as any)
+  const pending = commandMap['Editor.type'](722, 'x')
+  const selected = commandMap['Editor.setSelections2'](722, new Uint32Array([0, 1, 0, 1]))
+  expect(events).toEqual([])
+  gate.resolve()
+  await Promise.all([pending, selected])
+  expect(events).toEqual(['type', 'selection'])
+  Editors.dispose(722)
+})
